		"adhd",
		"tasks",
		"productivity"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.5",
		"builtin-modules": "^5.3.0",
		"esbuild": "^0.19.11",
		"obsidian": "^1.5.7",
		"tslib": "2.6.2",
		"typescript": "5.3.3"
	}
}
